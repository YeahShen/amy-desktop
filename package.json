{
  "name": "amy-desktop",
  "version": "0.0.10",
  "private": true,
  "description": "AMY Desktop - pnpm monorepo",
  "scripts": {
    "dev": "pnpm --parallel --filter=./packages/* run dev",
    "dev:mock": "pnpm --parallel --filter=./packages/* run dev:mock",
    "package": "run-s build:renderer build:main:package",
    "make": "run-s build:renderer build:main:make",
    "publish": "run-s build:publisher build:renderer build:main:publish",
    "build:renderer": "pnpm --filter=./packages/renderer-process run build",
    "build:main:package": "pnpm --filter=./packages/main-process run package",
    "build:main:stage": "pnpm --filter=./packages/main-process run stage",
    "build:main:make": "pnpm --filter=./packages/main-process run make",
    "build:main:publish": "pnpm --filter=./packages/main-process run publish",
    "build:publisher": "pnpm --filter=./packages/publisher run build",
    "lint": "eslint . --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "npm-run-all2": "^9.0.2",
    "prettier": "3.9.5",
    "typescript-eslint": "^8.64.0"
  }
}
